@model RestauranteCrud.Models.Cliente

@{
    ViewData["Title"] = "Informações do Cliente";
}

<div class="crud-container">
    <div class="crud-card">

        <div class="crud-title">
            <h1>👤 Informações do Cliente</h1>
            <p>Dados cadastrados no sistema</p>
        </div>

        <div class="info-list">

            <div class="info-item">
                <span class="info-label">Código:</span>
                <span class="info-value">@Model.IdCliente</span>
            </div>

            <div class="info-item">
                <span class="info-label">Nome:</span>
                <span class="info-value">@Model.NomeCliente</span>
            </div>

            <div class="info-item">
                <span class="info-label">CPF:</span>
                <span class="info-value">@Model.CPF</span>
            </div>

            <div class="info-item">
                <span class="info-label">Telefone:</span>
                <span class="info-value">@Model.Telefone</span>
            </div>

            <div class="info-item">
                <span class="info-label">E-mail:</span>
                <span class="info-value">@Model.Email</span>
            </div>

            <div class="info-item">
                <span class="info-label">Endereço:</span>
                <span class="info-value">@Model.Endereco</span>
            </div>

        </div>

        <div class="crud-buttons">
            <a asp-action="Index" class="btn-crud btn-voltar">← Voltar</a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdCliente"
               class="btn-crud btn-editar">
                ✏️ Editar
            </a>
        </div>

    </div>
</div>