@model IEnumerable<RestauranteCrud.Models.Pratos>

@{
    ViewData["Title"] = "Pratos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-warning">Pratos</h1>
            <p class="text-muted">Cardápio e gerenciamento dos pratos</p>
        </div>

        <a asp-action="Create" class="btn btn-warning">
            + Novo Prato
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-warning">
                        <tr>
                            <th>Prato</th>
                            <th>Descrição</th>
                            <th>Preço</th>
                            <th>Categoria</th>
                            <th>Fornecedor</th>
                            <th>Data de Cadastro</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.NomePrato
                                </td>

                                <td>
                                    @item.Descricao
                                </td>

                                <td class="fw-bold text-success">
                                    R$ @item.Preco.ToString("N2")
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Categoria
                                    </span>
                                </td>

                                <td>
                                    @item.Fornecedor?.NomeFornecedor
                                </td>

                                <td>
                                    @item.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.IdPrato"
                                       class="btn btn-sm btn-info text-white">
                                        Detalhes
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdPrato"
                                       class="btn btn-sm btn-warning">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.IdPrato"
                                       class="btn btn-sm btn-danger">
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>