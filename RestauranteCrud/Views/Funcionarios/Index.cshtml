@model IEnumerable<RestauranteCrud.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-success">Funcionários</h1>
            <p class="text-muted">Gerenciamento dos funcionários do restaurante</p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Novo Funcionário
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-success">
                        <tr>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Cargo</th>
                            <th>Telefone</th>
                            <th>Endereço</th>
                            <th>Salário</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.NomeFuncionario
                                </td>

                                <td>
                                    @item.CPF
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Cargo
                                    </span>
                                </td>

                                <td>
                                    @item.Telefone
                                </td>

                                <td>
                                    @item.Endereco
                                </td>

                                <td>
                                    R$ @item.Salario.ToString("N2")
                                </td>

                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.IdFuncionario"
                                       class="btn btn-sm btn-info text-white">
                                        Detalhes
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdFuncionario"
                                       class="btn btn-sm btn-warning">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.IdFuncionario"
                                       class="btn btn-sm btn-danger">
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>