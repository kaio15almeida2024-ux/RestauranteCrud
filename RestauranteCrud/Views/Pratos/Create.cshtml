@model RestauranteCrud.Models.Pratos

@{
    ViewData["Title"] = "Novo Prato";
}

<div class="container">
    <div class="form-card">

        <div class="form-header">
            <h1>🍴 Novo Prato</h1>
            <p>Cadastre um novo prato no cardápio</p>
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="NomePrato" class="form-label">
                        Nome do Prato
                    </label>
                    <input asp-for="NomePrato"
                           class="form-control"
                           placeholder="Ex: Filé com Fritas" />
                    <span asp-validation-for="NomePrato"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Categoria" class="form-label">
                        Categoria
                    </label>
                    <input asp-for="Categoria"
                           class="form-control"
                           placeholder="Ex: Prato Principal" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Preco" class="form-label">
                        Preço
                    </label>
                    <input asp-for="Preco"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="0,00" />
                    <span asp-validation-for="Preco"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="IdFornecedor" class="form-label">
                        Fornecedor
                    </label>

                    <select asp-for="IdFornecedor"
                            class="form-select"
                            asp-items="ViewBag.IdFornecedor">
                        <option value="">Selecione um fornecedor</option>
                    </select>

                    <span asp-validation-for="IdFornecedor"
                          class="text-danger"></span>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Descricao" class="form-label">
                        Descrição
                    </label>
                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="Descreva o prato"></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="form-buttons">
                <a asp-action="Index" class="btn btn-secondary">
                    ← Voltar
                </a>

                <button type="submit" class="btn btn-warning">
                    💾 Cadastrar Prato
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
