@model RestauranteCrud.Models.Funcionario

@{
    ViewData["Title"] = "Novo Funcionário";
}

<div class="container">
    <div class="form-card">

        <div class="form-header">
            <h1>👨‍🍳 Novo Funcionário</h1>
            <p>Cadastre um funcionário do restaurante</p>
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="NomeFuncionario" class="form-label">
                        Nome do Funcionário
                    </label>
                    <input asp-for="NomeFuncionario"
                           class="form-control"
                           placeholder="Digite o nome completo" />
                    <span asp-validation-for="NomeFuncionario"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CPF" class="form-label">
                        CPF
                    </label>
                    <input asp-for="CPF"
                           class="form-control"
                           placeholder="Digite o CPF" />
                    <span asp-validation-for="CPF"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Cargo" class="form-label">
                        Cargo
                    </label>
                    <input asp-for="Cargo"
                           class="form-control"
                           placeholder="Ex: Garçom, Cozinheiro..." />
                    <span asp-validation-for="Cargo"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Telefone" class="form-label">
                        Telefone
                    </label>
                    <input asp-for="Telefone"
                           class="form-control"
                           placeholder="Digite o telefone" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Salario" class="form-label">
                        Salário
                    </label>
                    <input asp-for="Salario"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="0,00" />
                    <span asp-validation-for="Salario"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Endereco" class="form-label">
                        Endereço
                    </label>
                    <input asp-for="Endereco"
                           class="form-control"
                           placeholder="Digite o endereço" />
                </div>

            </div>

            <div class="form-buttons">
                <a asp-action="Index" class="btn btn-secondary">
                    ← Voltar
                </a>

                <button type="submit" class="btn btn-warning">
                    💾 Cadastrar Funcionário
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}